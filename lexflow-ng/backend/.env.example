# Example only. DO NOT commit real secrets, client information or tokens.
NODE_ENV=development
PORT=8080
HOST=127.0.0.1
# PostgreSQL instance; production requires TLS and private networking.
DATABASE_URL=postgresql://lexflow_api:REPLACE_ME@localhost:5432/lexflow
DATABASE_SSL=false
# Use your REAL OIDC provider, issuer and public JWKS, not example placeholders.
OIDC_ISSUER=https://identity.example.ng/
OIDC_AUDIENCE=lexflow-api
OIDC_JWKS_URI=https://identity.example.ng/.well-known/jwks.json
ALLOWED_ORIGINS=http://localhost:5173,https://nigeriastudentcenter.github.io
# Release gates default off. Turn on only after security, legal and privacy approval.
ENABLE_APPLICATIONS=false
ENABLE_VERIFICATION=false
ENABLE_PUBLICATION=false
ENABLE_DIRECTORY=false
# Direct-to-lawyer engagements, invoices and receipts. LexFlow never holds legal fees.
ENABLE_ENGAGEMENTS=false
