# Azure Container Apps settings / secrets. Do not commit actual credentials.
DATABASE_URL=postgresql://runtime_user:REPLACE_PASSWORD@REPLACE_HOST:5432/lexflow_cpd
DATABASE_SSL=true
PUBLIC_WEB_ORIGIN=https://legal.bsoedu.org
ENTRA_ISSUER=https://YOUR-TENANT.ciamlogin.com/YOUR-TENANT-ID/v2.0
ENTRA_AUDIENCE=YOUR-API-APP-CLIENT-ID
ENTRA_JWKS_URI=https://YOUR-TENANT.ciamlogin.com/YOUR-TENANT-ID/discovery/v2.0/keys
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT
AZURE_OPENAI_API_VERSION=2024-10-21
# "true" lets a signed-in user create their own learner record. Leave unset to keep it closed.
ALLOW_SELF_REGISTRATION=false
